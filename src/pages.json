{
    "easycom": {
        "autoscan": true,
        "custom": {
            "^u-(.*)": "uview-plus/components/u-$1/u-$1.vue",
            "^up-(.*)": "uview-plus/components/up-$1/up-$1.vue"
        }
    },
    "pages": [
        {
            "path": "pages/index/index",
            "style": {
                "navigationBarTitleText": "夜市点餐",
                "enablePullDownRefresh": true
            }
        },
        {
            "path": "pages/cart/cart",
            "style": {
                "navigationBarTitleText": "购物车"
            }
        },
        {
            "path": "pages/order-confirm/order-confirm",
            "style": {
                "navigationBarTitleText": "确认订单"
            }
        },
        {
            "path": "pages/orders/orders",
            "style": {
                "navigationBarTitleText": "我的订单",
                "enablePullDownRefresh": true
            }
        },
        {
            "path": "pages/profile/profile",
            "style": {
                "navigationBarTitleText": "我的"
            }
        },
        {
            "path": "pages/stall/stall",
            "style": {
                "navigationBarTitleText": "摊位详情"
            }
        },
        {
            "path": "pages/order-detail/order-detail",
            "style": {
                "navigationBarTitleText": "订单详情"
            }
        },
        {
            "path": "pages/address/address",
            "style": {
                "navigationBarTitleText": "收货信息"
            }
        }
    ],
    "globalStyle": {
        "navigationBarTextStyle": "white",
        "navigationBarTitleText": "夜市点餐",
        "navigationBarBackgroundColor": "#0B0910",
        "backgroundColor": "#0B0910"
    },
    "tabBar": {
        "color": "#6F6785",
        "selectedColor": "#FFB02E",
        "backgroundColor": "#15121E",
        "borderStyle": "black",
        "list": [
            {
                "pagePath": "pages/index/index",
                "text": "点餐"
            },
            {
                "pagePath": "pages/cart/cart",
                "text": "购物车"
            },
            {
                "pagePath": "pages/order-confirm/order-confirm",
                "text": "确认订单"
            },
            {
                "pagePath": "pages/orders/orders",
                "text": "订单"
            },
            {
                "pagePath": "pages/profile/profile",
                "text": "我的"
            }
        ]
    }
}
